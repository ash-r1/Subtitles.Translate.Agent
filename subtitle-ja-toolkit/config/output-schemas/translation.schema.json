{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step 5: Translation Batch Output",
  "type": "object",
  "required": ["batch_id", "item_count", "first_item_id", "last_item_id", "items"],
  "additionalProperties": false,
  "properties": {
    "batch_id": {"type": "string"},
    "item_count": {"type": "integer", "minimum": 1,
                   "description": "items.length と一致すること。固定値ではなく入力件数"},
    "first_item_id": {"type": "string"},
    "last_item_id": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "original", "initial_translation"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "original": {"type": "string", "description": "入力原文を無改変でエコー"},
          "initial_translation": {"type": "string", "description": "翻訳文のみ。注釈禁止"},
          "speaker_id": {"type": ["string", "null"]},
          "listener_id": {"type": ["string", "null"]},
          "emotion": {"type": ["string", "null"]},
          "confidence": {"enum": ["high", "medium", "low", null]},
          "review_flags": {
            "type": "array",
            "items": {"enum": ["speaker_unknown", "long_line", "provisional_term",
                               "sentence_spans_batch", "no_glossary", "scene_uncertain",
                               "marked_structure"]}
          }
        }
      }
    },
    "new_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description", "evidence_ids"],
        "properties": {
          "type": {"enum": ["character", "relationship", "phrase", "term"]},
          "description": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^sub:[0-9]+(-[0-9]+)?$"}}
        }
      }
    }
  }
}
