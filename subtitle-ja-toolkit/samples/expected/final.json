[
  {
    "id": "1",
    "start": "00:00:01,000",
    "end": "00:00:03,200",
    "text": "艦長がブリッジに！"
  },
  {
    "id": "2",
    "start": "00:00:03,400",
    "end": "00:00:05,000",
    "text": "報告を　機関長"
  },
  {
    "id": "3",
    "start": "00:00:05,200",
    "end": "00:00:08,400",
    "text": "遭難信号を受信しました\n12マイル沖です"
  },
  {
    "id": "4",
    "start": "00:00:08,600",
    "end": "00:00:10,200",
    "text": "再生できるか"
  },
  {
    "id": "5",
    "start": "00:00:10,400",
    "end": "00:00:13,900",
    "text": "…誰か…　機関室が浸水…\nもう持たない…"
  },
  {
    "id": "6",
    "start": "00:00:14,100",
    "end": "00:00:15,600",
    "text": "拾えたのはここまで"
  },
  {
    "id": "7",
    "start": "00:00:15,800",
    "end": "00:00:17,300",
    "text": "針路を取れ　全速前進"
  },
  {
    "id": "8",
    "start": "00:00:17,500",
    "end": "00:00:19,000",
    "text": "ようそろ"
  },
  {
    "id": "9",
    "start": "00:00:19,200",
    "end": "00:00:22,100",
    "text": "コール少尉　前甲板へ"
  },
  {
    "id": "10",
    "start": "00:00:22,300",
    "end": "00:00:23,500",
    "text": "了解しました"
  },
  {
    "id": "11",
    "start": "00:00:23,700",
    "end": "00:00:26,800",
    "text": "モーガン\n16チャンネルで呼びかけ続けろ"
  },
  {
    "id": "12",
    "start": "00:00:27,000",
    "end": "00:00:28,300",
    "text": "もうやってる"
  },
  {
    "id": "13",
    "start": "00:00:28,500",
    "end": "00:00:31,900",
    "text": "最高だね　前線か　ついてるよ"
  },
  {
    "id": "14",
    "start": "00:00:32,100",
    "end": "00:00:35,400",
    "text": "前線に追いつかれる前に\n到着できなければ"
  },
  {
    "id": "15",
    "start": "00:00:35,600",
    "end": "00:00:38,700",
    "text": "あの船の全員が\nええ　一人残らずです"
  },
  {
    "id": "16",
    "start": "00:00:38,900",
    "end": "00:00:41,200",
    "text": "夜明けには海に投げ出されます"
  },
  {
    "id": "17",
    "start": "00:00:41,400",
    "end": "00:00:43,100",
    "text": "なら先に着くまでだ"
  },
  {
    "id": "18",
    "start": "00:00:43,300",
    "end": "00:00:45,200",
    "text": "ダニー　大丈夫？　顔色悪いよ"
  },
  {
    "id": "19",
    "start": "00:00:45,400",
    "end": "00:00:48,100",
    "text": "大丈夫だと言っただろ\nお前こそ心配しろ"
  },
  {
    "id": "20",
    "start": "00:00:48,300",
    "end": "00:00:51,000",
    "text": "機関長\n機関室の件は君が正しかった"
  },
  {
    "id": "21",
    "start": "00:00:51,200",
    "end": "00:00:54,300",
    "text": "恐れながら艦長\n機関で私は間違えません"
  },
  {
    "id": "22",
    "start": "00:00:54,500",
    "end": "00:00:57,200",
    "text": "コール！　降りなさい！\n正気ですか"
  },
  {
    "id": "23",
    "start": "00:00:57,400",
    "end": "00:00:59,000",
    "text": "索が絡んだんです！"
  },
  {
    "id": "24",
    "start": "00:00:59,200",
    "end": "00:01:02,550",
    "text": "燃えていても同じです\n手順には従ってもらいます"
  },
  {
    "id": "25",
    "start": "00:01:02,600",
    "end": "00:01:04,000",
    "text": "はい　機関長"
  },
  {
    "id": "26",
    "start": "00:01:04,200",
    "end": "00:01:06,500",
    "text": "いました！　左舷前方です！"
  },
  {
    "id": "27",
    "start": "00:01:06,700",
    "end": "00:01:08,200",
    "text": "確認した　回頭しろ"
  },
  {
    "id": "28",
    "start": "00:01:08,400",
    "end": "00:01:10,100",
    "text": "ようそろ"
  },
  {
    "id": "29",
    "start": "00:01:10,300",
    "end": "00:01:13,000",
    "text": "今日はよくやった　ダニー　休め"
  },
  {
    "id": "30",
    "start": "00:01:13,200",
    "end": "00:01:14,800",
    "text": "艦長も"
  }
]