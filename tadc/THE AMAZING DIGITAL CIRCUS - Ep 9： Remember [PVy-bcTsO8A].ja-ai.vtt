♪♪

729
00:41:20.050 --> 00:41:27.040
♪♪

730
00:41:27.070 --> 00:41:34.070
♪♪

731
00:41:34.100 --> 00:41:41.090
♪♪

732
00:41:41.120 --> 00:41:43.970
♪♪

733
00:41:44.000 --> 00:41:45.996


734
00:41:46.020 --> 00:41:48.110
♪♪

735
00:41:48.140 --> 00:41:53.506
♪♪

736
00:41:53.530 --> 00:41:54.990


737
00:41:55.020 --> 00:41:56.710
♪♪

738
00:41:56.740 --> 00:41:58.710


739
00:41:58.740 --> 00:42:05.730
♪♪

740
00:42:05.760 --> 00:42:12.750
♪♪

741
00:42:12.780 --> 00:42:19.780
♪♪

742
00:42:19.810 --> 00:42:26.800
♪♪

743
00:42:26.830 --> 00:42:33.166
♪♪

744
00:42:33.190 --> 00:42:35.020


745
